APP_ENV=local
APP_PORT=8080
APP_LOG_LEVEL=info

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ai_hs
DB_PASSWORD=ai_hs
DB_NAME=ai_hs_go
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Shanghai

# Redis (asynq)
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=please-change-me-to-a-32+byte-random-string
JWT_TTL_SECONDS=86400
JWT_ISSUER=ai_hs_go

# RSA password decryption (PEM, base64-encoded; fall back to inline if needed)
RSA_PRIVATE_KEY_PATH=./configs/rsa_private.pem
RSA_PUBLIC_KEY_PATH=./configs/rsa_public.pem

# Aliyun OSS
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=ai-hs-go
OSS_PUBLIC_URL=https://ai-hs-go.oss-cn-beijing.aliyuncs.com

# CORS (comma-separated origins; * for dev)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
